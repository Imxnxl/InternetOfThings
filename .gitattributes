# Normaliza los finales de linea en el repositorio (LF), respetando el
# convenio local en el arbol de trabajo.
* text=auto

*.c    text eol=lf
*.h    text eol=lf
*.cpp  text eol=lf
*.py   text eol=lf
*.sh   text eol=lf
*.md   text eol=lf
*.ini  text eol=lf
*.json text eol=lf
*.csv  text eol=lf
*.log  text eol=lf

*.png  binary
*.docx binary
